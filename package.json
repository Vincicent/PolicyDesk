{
  "name": "policydesk",
  "private": true,
  "type": "module",
  "scripts": {
    "db:seed": "node db/generate-seed.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "api": "wrangler pages dev backoffice --port 8788",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:remote": "wrangler d1 migrations apply policydesk --remote",
    "typecheck:api": "tsc -p functions",
    "smoke": "node scripts/smoke.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@uirouter/angularjs": "1.1.2",
    "angular": "1.8.3",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
